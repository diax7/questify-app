{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "mutate": ["packages/*/src/**/*.ts", "apps/api/src/**/*.ts", "!**/*.test.ts", "!**/index.ts"],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "reporters": ["clear-text", "progress"],
  "coverageAnalysis": "off",
  "tempDirName": ".stryker-tmp",
  "ignorePatterns": ["docs", ".github", ".git", ".stryker-tmp", "reports"],
  "clearTextReporter": {
    "logTests": false,
    "allowColor": false
  }
}
