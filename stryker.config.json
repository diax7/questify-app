{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": {
    "configFile": "vitest.stryker.config.ts"
  },
  "mutate": [
    "apps/api/src/audit/**/*.ts",
    "apps/api/src/auth/**/*.ts",
    "apps/api/src/db/**/*.ts",
    "apps/api/src/conventions.ts",
    "apps/api/src/idempotency-store.ts",
    "apps/api/src/route-access.ts",
    "apps/api/src/organizers/**/*.ts",
    "apps/api/src/events/**/*.ts",
    "apps/api/src/quests/**/*.ts",
    "apps/api/src/completions/**/*.ts",
    "apps/api/src/players/**/*.ts",
    "apps/api/src/join/**/*.ts",
    "apps/api/src/moderation/**/*.ts",
    "apps/api/src/audience/**/*.ts",
    "apps/api/src/deletion/**/*.ts",
    "apps/api/src/home/**/*.ts",
    "apps/api/src/rewards/**/*.ts",
    "apps/api/src/operators/**/*.ts",
    "apps/api/src/awards/**/*.ts",
    "apps/api/src/desk/**/*.ts",
    "apps/api/src/flags/**/*.ts",
    "apps/api/src/activation/**/*.ts",
    "apps/api/src/rehearsal/**/*.ts",
    "apps/api/src/results/**/*.ts",
    "apps/api/src/plays/**/*.ts",
    "apps/api/src/passport/**/*.ts",
    "apps/api/src/reveal/**/*.ts",
    "apps/api/src/submissions/**/*.ts",
    "apps/api/src/tickets/**/*.ts",
    "apps/api/src/ranking/**/*.ts",
    "apps/api/src/souvenirs/**/*.ts",
    "apps/api/src/questify/**/*.ts",
    "packages/shared/src/results/**/*.ts",
    "packages/shared/src/souvenirs.ts",
    "packages/shared/src/questify/**/*.ts",
    "packages/shared/src/quests/**/*.ts",
    "packages/shared/src/players/**/*.ts",
    "packages/shared/src/join/**/*.ts",
    "apps/app/src/api/client.ts",
    "apps/app/src/api/session.ts",
    "packages/shared/src/time/**/*.ts",
    "!**/*.test.ts",
    "!**/*.d.ts",
    "!packages/shared/src/games/testing/**"
  ],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "reporters": ["clear-text", "progress"],
  "coverageAnalysis": "perTest",
  "tempDirName": ".stryker-tmp",
  "ignorePatterns": ["docs", ".github", ".git", ".claude", ".stryker-tmp", "reports"],
  "clearTextReporter": {
    "logTests": false,
    "allowColor": false
  }
}
