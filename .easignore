# EAS uploads the repository minus this list (it replaces .gitignore for EAS). Keep .gitignore's lines, plus folders
# the app build never reads: the docs (evidence screenshots and design art, about 90 MB).
.env
.env.*
!.env.example
__pycache__/
node_modules/
dist/
coverage/
.expo/
*.log
.DS_Store

# Large or confidential planning assets stay out of git (back them up separately)
docs/design/assets/
docs/design/codex-image-2/
docs/design/references/*.pdf
docs/inputs/
.stryker-tmp/
reports/
sbom.cdx.json

# Native projects are generated by Expo (prebuild) and are not kept in git
/apps/app/android/
/apps/app/ios/

# Next.js build output (apps/web)
.next/
next-env.d.ts

# Browser-test output and the bundled test API server
apps/web/.e2e/
apps/api/test/support/e2e-server.bundle.mjs

docs/
