{
  "expo": {
    "name": "Questify",
    "slug": "nafes",
    "scheme": "questify",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "app.questify.mobile",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleLocalizations": ["ar", "en"]
      }
    },
    "android": {
      "package": "app.questify.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["ar", "en"],
            "android": ["ar", "en"]
          }
        }
      ],
      "expo-splash-screen",
      "expo-status-bar"
    ],
    "updates": {
      "enabled": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1ff85195-221e-4284-87b5-392d625f94cc"
      }
    },
    "owner": "nafess-team"
  }
}
