    {
      "id": 9,
      "type": "timeseries",
      "title": "5xx share of requests",
      "description": "Fast burn pages above 1.44% (5 minutes and 1 hour); slow burn opens a ticket above 0.6% (30 minutes and 6 hours).",
      "datasource": {
        "type": "prometheus",
        "uid": "questify-prometheus"
