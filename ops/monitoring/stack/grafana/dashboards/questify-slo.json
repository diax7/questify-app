    {
      "id": 16,
      "type": "timeseries",
      "title": "Loop lateness at its last report",
      "description": "How late each loop already was when it last reported. Over 300 s pages for a loop (QuestifyLoopStalled); the ranking repair pages over 30 s (QuestifyRankingRepairStalled).",
      "datasource": {
        "type": "prometheus",
        "uid": "questify-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "questify-prometheus"
          },
          "refId": "A",
          "expr": "max by (questify_tick) ((timestamp(questify_tick_last_run_seconds) - questify_tick_last_run_seconds) and on (instance, questify_tick) (time() - timestamp(questify_tick_last_run_seconds) < 120))",
          "legendFormat": "{{questify_tick}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "noValue": "no data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 300
