    {
      "id": 19,
      "type": "timeseries",
      "title": "Share of sends that fail",
      "description": "SMS pages above 20% (refused, unknown, failed); push warns above 20%; email pages above 60%.",
      "datasource": {
        "type": "prometheus",
        "uid": "questify-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "questify-prometheus"
          },
          "refId": "A",
          "expr": "sum(rate(questify_outbound_requests_total{questify_operation=\"sms\",questify_outcome=~\"refused|unknown|failed\"}[$__rate_interval])) / sum(rate(questify_outbound_requests_total{questify_operation=\"sms\"}[$__rate_interval]))",
          "legendFormat": "SMS",
          "instant": false,
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "questify-prometheus"
          },
          "refId": "B",
          "expr": "sum(rate(questify_outbound_requests_total{questify_operation=\"push\",questify_outcome=~\"failed|unknown|requeue|hold\"}[$__rate_interval])) / sum(rate(questify_outbound_requests_total{questify_operation=\"push\"}[$__rate_interval]))",
          "legendFormat": "push",
          "instant": false,
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "questify-prometheus"
          },
          "refId": "C",
          "expr": "sum(rate(questify_outbound_requests_total{questify_operation=\"email\",questify_outcome=~\"failed\"}[$__rate_interval])) / sum(rate(questify_outbound_requests_total{questify_operation=\"email\"}[$__rate_interval]))",
          "legendFormat": "email",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
