{
  "plugins": [],
  "categories": { "correctness": "off" },
  "rules": {
    "max-lines-per-function": [
      "error",
      { "max": 100, "skipBlankLines": true, "skipComments": true }
    ],
    "complexity": ["error", 8]
  },
  "ignorePatterns": [
    "node_modules",
    "dist",
    "coverage",
    ".expo",
    ".next",
    "docs",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "apps/*/test/**",
    "apps/*/e2e/**"
  ]
}
