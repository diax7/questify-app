{
  "plugins": ["typescript", "import", "unicorn"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "import/no-relative-parent-imports": "error",
    "no-console": "warn"
  },
  "overrides": [
    {
      "files": ["apps/app/**", "packages/shared/**"],
      "rules": { "unicorn/no-array-sort": "off" }
    }
  ],
  "ignorePatterns": ["node_modules", "dist", "coverage", ".expo", "docs"]
}
